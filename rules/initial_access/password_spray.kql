// Rule: Password Spray Attack Detected
// Description: Detects a single IP attempting failed logins against 5 or more distinct accounts within 1 hour with fewer than 3 attempts per user.
// MITRE ATT&CK Technique: T1110.003 - Password Spraying
// MITRE Tactic: Initial Access
// Severity: High
// Author: solosurge
// Version: 1.0

SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType != "0"
| summarize
    TargetedAccounts = dcount(UserPrincipalName),
    TotalFailures = count(),
    AccountList = make_set(UserPrincipalName),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 1h)
| extend AttemptsPerUser = todouble(TotalFailures) / todouble(TargetedAccounts)
| where TargetedAccounts >= 5 and AttemptsPerUser < 3
| extend AlertSeverity = "High"
| extend RuleName = "Password Spray Attack Detected"
| project-reorder TimeGenerated, IPAddress, TargetedAccounts, TotalFailures, AttemptsPerUser, AccountList, FirstAttempt, LastAttempt, AlertSeverity, RuleName
| order by TargetedAccounts desc
